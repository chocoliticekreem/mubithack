{
  "name": "friendly_fire_blame",
  "description": "Friendly fire: player A hoses player B for 3 s; a hose_hit event names A as the sprayer, B ragdolls, and BlameService pins it on A.",
  "requires": ["players>=2", "ToolService"],
  "steps": [
    {"label": "players spawned", "wait_until": {"cmd": "players", "path": "result.*.health", "op": ">", "value": 0, "timeout": 20}, "save": "p"},
    {"label": "start a mission for both", "soft": true, "call": {"cmd": "mission_start", "args": {"players": ["$p.0.userId", "$p.1.userId"], "wait": 15}}, "save": "m"},
    {"label": "B 10 studs from A", "call": {"cmd": "teleport", "args": {"userId": "$p.1.userId", "to": "$p.0.userId", "offset": [10, 0, 0]}}},
    {"wait": 0.5},
    {"label": "mark events", "call": {"cmd": "events"}, "save": "t0"},
    {"label": "A takes the hose", "act": {"player": "$p.0.userId", "action": "equip", "args": {"name": "Hose"}}},
    {"label": "A sprays B", "act": {"player": "$p.0.userId", "action": "use", "args": {"seconds": 3, "target_player": "$p.1.userId"}}},
    {"label": "hose_hit by A", "wait_until": {"cmd": "events", "args": {"since": "$t0.now", "kinds": ["hose_hit"]}, "path": "result.events", "op": "contains", "value": "$p.1.name", "timeout": 5}},
    {"require": ["Ragdoll"], "label": "ragdoll implemented?"},
    {"label": "B ragdolled", "wait_until": {"timeout": 5, "any": [
      {"cmd": "players", "args": {"userIds": ["$p.1.userId"]}, "path": "result.0.ragdolled", "op": "truthy"},
      {"cmd": "events", "args": {"since": "$t0.now", "kinds": ["ragdolled"]}, "path": "result.events", "op": "contains", "value": "$p.1.name"}
    ]}},
    {"require": ["BlameService"], "label": "blame implemented?"},
    {"label": "blame on A", "wait_until": {"timeout": 5, "any": [
      {"cmd": "blame", "args": {"userIds": ["$p.0.userId"]}, "path": "result.stats.0.teammateSprayed", "op": ">", "value": 0},
      {"cmd": "blame", "args": {"userIds": ["$p.0.userId"]}, "path": "result.stats.0.downedOthers", "op": ">", "value": 0}
    ]}},
    {"label": "end mission", "soft": true, "call": {"cmd": "mission_end", "args": {"player": "$p.0.userId"}}}
  ]
}
