--!strict
-- AlarmLogic: run merging (full beats quiet, bays union), expiry, stages, volumes.
local Spec = require("./Spec")
local A = require("../StarterPlayerScripts/Lib/AlarmLogic")

Spec.test("idle until triggered", function()
	local s = A.new()
	Spec.eq(A.active(s, 0), false)
	Spec.eq(A.stage(s, 0), "idle")
end)

Spec.test("trigger starts a run and reports fresh", function()
	local s = A.new()
	Spec.eq(A.trigger(s, 10, A.FULL, 5, { 2 }, "House fire"), true)
	Spec.eq(A.active(s, 12), true)
	Spec.eq(s.title, "House fire")
	Spec.eq(A.sortedBays(s)[1], 2)
end)

Spec.test("quiet then full upgrades, full then quiet stays full", function()
	local s = A.new()
	A.trigger(s, 0, A.QUIET, 4, nil, nil)
	Spec.eq(s.level, A.QUIET)
	Spec.eq(A.trigger(s, 1, A.FULL, 2, nil, nil), false)
	Spec.eq(s.level, A.FULL)
	A.trigger(s, 1.5, A.QUIET, 1, nil, nil)
	Spec.eq(s.level, A.FULL)
end)

Spec.test("extends but never shortens", function()
	local s = A.new()
	A.trigger(s, 0, A.FULL, 10, nil, nil)
	A.trigger(s, 1, A.QUIET, 2, nil, nil)
	Spec.eq(s.untilAt, 10)
	A.trigger(s, 9, A.QUIET, 5, nil, nil)
	Spec.eq(s.untilAt, 14)
end)

Spec.test("bays union and are cleaned", function()
	local s = A.new()
	A.trigger(s, 0, A.FULL, 5, { 1, "3", 9, 0, 1.5 }, nil)
	A.trigger(s, 1, A.QUIET, 5, { 4, 3 }, nil)
	local b = A.sortedBays(s)
	Spec.eq(#b, 3)
	Spec.eq(b[1], 1)
	Spec.eq(b[2], 3)
	Spec.eq(b[3], 4)
end)

Spec.test("expire clears once, then a new run is fresh with a new start", function()
	local s = A.new()
	A.trigger(s, 0, A.FULL, 3, { 1 }, "x")
	Spec.eq(A.expire(s, 2), false)
	Spec.eq(A.expire(s, 3), true)
	Spec.eq(A.expire(s, 4), false)
	Spec.eq(s.level, 0)
	Spec.eq(#A.sortedBays(s), 0)
	Spec.eq(A.trigger(s, 5, A.QUIET, 1, nil, nil), true)
	Spec.eq(s.startedAt, 5)
end)

Spec.test("a late trigger after timeout restarts the sequence", function()
	local s = A.new()
	A.trigger(s, 0, A.FULL, 2, { 2 }, nil)
	Spec.eq(A.trigger(s, 3, A.QUIET, 2, nil, nil), true)
	Spec.eq(s.level, A.QUIET)
	Spec.eq(#A.sortedBays(s), 0)
end)

Spec.test("stages run tones -> wail -> go", function()
	local s = A.new()
	A.trigger(s, 100, A.FULL, 10, nil, nil)
	Spec.eq(A.stage(s, 100.2), "tones")
	Spec.eq(A.stage(s, 101.2), "wail")
	Spec.eq(A.stage(s, 103), "go")
	Spec.eq(A.stage(s, 111), "idle")
end)

Spec.test("volume by level", function()
	Spec.eq(A.volume(A.FULL, 0.8), 0.8)
	Spec.near(A.volume(A.QUIET, 0.8), 0.8 * A.QuietVolume)
	Spec.eq(A.volume(0, 0.8), 0)
end)

Spec.test("wail stays in a sane pitch band", function()
	for i = 0, 50 do
		local p = A.wail(i * 0.1)
		Spec.eq(p >= 0.89 and p <= 1.16, true, `pitch at {i}`)
	end
end)

Spec.test("beacon angle wraps", function()
	local a = A.beaconAngle(12.3)
	Spec.eq(a >= 0 and a < 2 * math.pi, true)
end)

return Spec.finish()
