--!strict
-- Inventory slot/state rules (ReplicatedStorage/Lib/Items/ItemDefs): grab, drop, throw, swap, fumble,
-- shared reels (2 nozzles a truck), thrown-axe spin, throw charge, no supply line, bonks.
local Spec = require("./Spec")
local D = require("../ReplicatedStorage/Lib/Items/ItemDefs") :: any

local function S(hand: string?, back: string?, carry: string?)
	return { hand = hand, back = back, carry = carry }
end

Spec.test("every item def is complete and keyed by its id", function()
	for id, def in D.Items do
		Spec.eq(def.id, id, "id")
		Spec.eq(type(def.name), "string", `{id}.name`)
		Spec.eq(type(def.short), "string", `{id}.short`)
		Spec.eq(string.match(def.color, "^#%x%x%x%x%x%x$") ~= nil, true, `{id}.color`)
		if def.prefersBack then
			Spec.eq(def.backable, true, `{id} prefersBack needs backable`)
		end
		if def.tethered then
			Spec.eq(def.stocked, false, `{id} tethered items come from reels, not racks`)
		end
	end
	for _, id in D.RackOrder do
		Spec.eq(D.Items[id].stocked, true, `rack item {id}`)
	end
end)

Spec.test("grab into an empty hand", function()
	local ok, s, plan = D.grab(S(), "Axe")
	Spec.eq(ok, true)
	Spec.eq(s.hand, "Axe")
	Spec.eq(plan.slot, "hand")
end)

Spec.test("the oxygen tank goes on your back when it is free, else in your hand", function()
	local _, s, plan = D.grab(S("Axe"), "OxygenTank")
	Spec.eq(s.back, "OxygenTank")
	Spec.eq(s.hand, "Axe")
	Spec.eq(plan.slot, "back")
	local _, s2, plan2 = D.grab(S(nil, "OxygenTank"), "OxygenTank")
	Spec.eq(s2.hand, "OxygenTank")
	Spec.eq(plan2.slot, "hand")
end)

Spec.test("a full hand stows a backable item on the back", function()
	local _, s, plan = D.grab(S("Axe"), "Extinguisher")
	Spec.eq(s.hand, "Extinguisher")
	Spec.eq(s.back, "Axe")
	Spec.eq(plan.stowed, "Axe")
	Spec.eq(plan.dropped, nil)
end)

Spec.test("full hand and back: the old hand item drops at your feet", function()
	local _, s, plan = D.grab(S("Axe", "OxygenTank"), "Extinguisher")
	Spec.eq(s.hand, "Extinguisher")
	Spec.eq(s.back, "OxygenTank")
	Spec.eq(plan.dropped, "Axe")
end)

Spec.test("grabbing over the hose slings it on your back (never drops it)", function()
	local _, s, plan = D.grab(S("Hose"), "Axe")
	Spec.eq(s.hand, "Axe")
	Spec.eq(s.back, "Hose")
	Spec.eq(plan.stowed, "Hose")
	Spec.eq(plan.dropped, nil)
	-- back taken: the back item drops, the hose still goes over your shoulder
	local _, s2, plan2 = D.grab(S("Hose", "OxygenTank"), "Axe")
	Spec.eq(s2.hand, "Axe")
	Spec.eq(s2.back, "Hose")
	Spec.eq(plan2.dropped, "OxygenTank")
	Spec.eq(plan2.droppedSlot, "back")
end)

Spec.test("grab refuses when downed, carrying, unknown or already on the hose", function()
	Spec.eq((D.grab(S(), "Axe", { downed = true })), false)
	Spec.eq((D.grab(S(), "Axe", { carryingNpc = true })), false)
	Spec.eq((D.grab(S(nil, nil, D.PROP), "Axe")), false)
	Spec.eq((D.grab(S(), "Banana")), false)
	local ok, s, plan = D.grab(S("Hose"), "Hose")
	Spec.eq(ok, false)
	Spec.eq(s.hand, "Hose")
	Spec.eq(plan.reason, "already holding")
	local ok2, _, plan2 = D.grab(S("Axe", "Hose"), "Hose")
	Spec.eq(ok2, false, "one hose per firefighter, even slung on your back")
	Spec.eq(plan2.reason, "already holding")
end)

Spec.test("grab never mutates the input state", function()
	local before = S("Axe")
	D.grab(before, "Extinguisher")
	Spec.eq(before.hand, "Axe")
	Spec.eq(before.back, nil)
end)

Spec.test("drop takes the carried prop first, then the hand, never the back", function()
	local s, what, slot = D.drop(S("Axe", "OxygenTank", D.PROP))
	Spec.eq(what, D.PROP)
	Spec.eq(slot, "carry")
	Spec.eq(s.hand, "Axe")
	local s2, what2, slot2 = D.drop(s)
	Spec.eq(what2, "Axe")
	Spec.eq(slot2, "hand")
	local s3, what3 = D.drop(s2)
	Spec.eq(what3, nil)
	Spec.eq(s3.back, "OxygenTank")
end)

Spec.test("throw follows drop order", function()
	local s, what, slot = D.throw(S("Axe"))
	Spec.eq(what, "Axe")
	Spec.eq(slot, "hand")
	Spec.eq(s.hand, nil)
	local _, w2 = D.throw(S())
	Spec.eq(w2, nil)
end)

Spec.test("swap hand and back", function()
	local ok, s = D.swap(S("Axe", "OxygenTank"))
	Spec.eq(ok, true)
	Spec.eq(s.hand, "OxygenTank")
	Spec.eq(s.back, "Axe")
	local ok2, s2 = D.swap(S(nil, "OxygenTank"))
	Spec.eq(ok2, true)
	Spec.eq(s2.hand, "OxygenTank")
	Spec.eq(s2.back, nil)
	local ok3, s3 = D.swap(S("Axe"))
	Spec.eq(ok3, true)
	Spec.eq(s3.back, "Axe")
	Spec.eq(s3.hand, nil)
end)

Spec.test("swap moves the hose to your back and back again", function()
	local ok, s = D.swap(S("Hose", "Axe"))
	Spec.eq(ok, true)
	Spec.eq(s.hand, "Axe")
	Spec.eq(s.back, "Hose")
	local ok2, s2 = D.swap(s)
	Spec.eq(ok2, true)
	Spec.eq(s2.hand, "Hose")
	Spec.eq(s2.back, "Axe")
	local ok3, s3 = D.swap(S("Hose"))
	Spec.eq(ok3, true, "hands free, hose slung")
	Spec.eq(s3.back, "Hose")
	Spec.eq(s3.hand, nil)
end)

Spec.test("swap refuses an empty kit and full arms", function()
	Spec.eq((D.swap(S())), false)
	Spec.eq((D.swap(S("Axe", nil, D.PROP))), false)
end)

Spec.test("fumble drops hand and carry, keeps the back", function()
	local s, hand, carry = D.fumble(S("Hose", "OxygenTank", D.PROP))
	Spec.eq(hand, "Hose")
	Spec.eq(carry, D.PROP)
	Spec.eq(s.hand, nil)
	Spec.eq(s.carry, nil)
	Spec.eq(s.back, "OxygenTank")
end)

Spec.test("grabProp needs free arms", function()
	local ok, s = D.grabProp(S("Axe"))
	Spec.eq(ok, true)
	Spec.eq(s.carry, D.PROP)
	Spec.eq(s.hand, "Axe")
	Spec.eq((D.grabProp(s)), false)
	Spec.eq((D.grabProp(S(), { carryingNpc = true })), false)
end)

Spec.test("reels are anyone's: two nozzles per truck, a lying one gets reeled back in", function()
	Spec.eq(D.reelSlot(0, 0, 2), "new")
	Spec.eq(D.reelSlot(1, 0, 2), "new") -- a second firefighter (owner or not) gets the second hose
	Spec.eq(D.reelSlot(2, 0, 2), "full")
	Spec.eq(D.reelSlot(1, 1, 2), "reclaim") -- the dropped one comes back on the reel for you
	Spec.eq(D.reelSlot(0, 2, 2), "reclaim")
	Spec.eq(D.reelSlot(0, 0, 1), "new") -- a one-nozzle reel
	Spec.eq(D.reelSlot(1, 0, 1), "full")
end)

Spec.test("axes and bars spin when thrown, the rest tumble", function()
	local list = { "Axe", "FireAxe", "GoldenAxe", "Halligan", "Sledgehammer" }
	Spec.eq(D.spinsWhenThrown("GoldenAxe", list), true)
	Spec.eq(D.spinsWhenThrown("Halligan", list), true)
	Spec.eq(D.spinsWhenThrown("Extinguisher", list), false)
	Spec.eq(D.spinsWhenThrown(nil, list), false)
	Spec.eq(D.spinsWhenThrown("Axe", nil), false)
end)

Spec.test("rack items: Item attr wins, else Slot wraps over RackOrder", function()
	Spec.eq(D.rackItem("Extinguisher", 1), "Extinguisher")
	Spec.eq(D.rackItem(nil, 1), D.RackOrder[1])
	Spec.eq(D.rackItem(nil, #D.RackOrder + 1), D.RackOrder[1])
	Spec.eq(D.rackItem("Banana", 2), D.RackOrder[2])
	Spec.eq(D.rackItem(nil, nil), nil)
end)

Spec.test("throw speed scales with charge, clamped", function()
	Spec.near(D.throwSpeed(0, 30, 90), 30)
	Spec.near(D.throwSpeed(1, 30, 90), 90)
	Spec.near(D.throwSpeed(0.5, 30, 90), 60)
	Spec.near(D.throwSpeed(5, 30, 90), 90)
	Spec.near(D.throwSpeed(0 / 0, 30, 90), 30)
end)

Spec.test("no supply line: the coupling item is gone (trucks have endless water)", function()
	Spec.eq(D.get("SupplyHose"), nil)
	Spec.eq((D :: any).drawWater, nil)
	Spec.eq((D :: any).hydrantAction, nil)
end)

Spec.test("bonks only at speed", function()
	Spec.eq(D.bonkSpeed(30, 18), true)
	Spec.eq(D.bonkSpeed(10, 18), false)
end)

return Spec.finish()
