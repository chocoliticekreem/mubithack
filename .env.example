# Every LLM call goes through Mubit. Get a key (mbt_...) at https://app.mubit.ai/console/
MUBIT_API_KEY=mbt_xxx
# anthropic -> https://api.mubit.ai/anthropic   openai -> https://api.mubit.ai/openai/v1
FORGE_PROVIDER=anthropic
MUBIT_BASE_URL=https://api.mubit.ai/anthropic
FORGE_MODEL=claude-sonnet-5
# Optional
STUDIO_MCP_PATH=/Applications/RobloxStudio.app/Contents/MacOS/StudioMCP
FORGE_SYNC_PORT=34873
